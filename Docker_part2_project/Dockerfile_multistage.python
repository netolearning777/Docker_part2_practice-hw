# --- Этап 1: Сборка зависимостей (builder) ---
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Установка рабочей директории внутри контейнера
WORKDIR /app

# Создаём виртуальное окружение и ставим в него зависимости
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# --- Этап 2: Финальный образ (runtime) ---
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Копируем только готовое виртуальное окружение из первого этапа
COPY --from=builder /opt/venv /opt/venv

# Создаём непривилегированного пользователя и копируем код приложения
RUN useradd -m appuser
COPY --chown=appuser:appuser . .

USER appuser

# Запускаем приложение с помощью uvicorn, делая его доступным по сети
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "5000"]
